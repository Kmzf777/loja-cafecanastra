{
  "name": "loja-cafecanastra",
  "private": true,
  "description": "Loja do Café Canastra — vitrine Next 15 + API Express/PostgreSQL + painel administrativo.",
  "scripts": {
    "db:migrar": "node backend/db/migrar.js",
    "db:gerar-sql": "node backend/db/gerar-instalacao.js",
    "db:seed": "node backend/db/seed.js",
    "db:setup": "npm run db:migrar && npm run db:seed",
    "verifica:rls": "node backend/scripts/verifica-rls.mjs",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test",
    "verifica": "node frontend/scripts/verifica-fluxo.mjs"
  },
  "dependencies": {
    "express-rate-limit": "^8.5.2",
    "resend": "^6.8.0"
  }
}
