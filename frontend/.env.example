# Copie para frontend/.env.local antes de subir a vitrine:
#   cp frontend/.env.example frontend/.env.local
#
# `.env.local` esta no .gitignore; `.env.example` nao.
#
# TUDO QUE COMECA COM `NEXT_PUBLIC_` VAI EMBUTIDO NO BUNDLE que qualquer
# visitante baixa. Nao existe segredo aqui — a `service_role key` do Supabase e
# o `SUPABASE_JWT_SECRET` NUNCA entram neste arquivo nem com outro nome. Eles
# vivem so em backend/src/.env, do lado do servidor.

# ── Supabase ────────────────────────────────────────────────────────────────
# Origem publica da instancia (o que o Kong atende) e a chave `anon`.
#
# A `anon key` E PUBLICA POR DEFINICAO: ela identifica o projeto, nao a pessoa.
# Quem protege o dado e a RLS do schema `canastra`, mais o vinculo em
# `canastra.clientes` que toda politica de dono exige.
#
# Sem estas duas a vitrine NAO SOBE: `lib/supabase/ambiente.ts` levanta erro
# nomeando a variavel que falta, de proposito — um cliente Supabase montado com
# `undefined` falharia so na primeira chamada, em runtime, com "Invalid URL".
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Origem da propria loja ──────────────────────────────────────────────────
# Base das URLs absolutas: metadata do Next e, principalmente, o `redirectTo`
# dos e-mails do GoTrue (confirmacao de cadastro e recuperacao de senha).
#
# ESTE VALOR PRECISA CASAR COM A ALLOW-LIST de Authentication > URL
# Configuration no painel do Supabase (`${origin}/account/verify-email` e
# `${origin}/account/reset-password`). Uma URL fora da lista NAO da erro: ela e
# trocada em silencio pela Site URL, e o cliente clica no e-mail e cai na home.
# Ver docs/producao.md §3.5.1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Servico Node ────────────────────────────────────────────────────────────
# Pagamento, webhook, frete, e-mail e exclusao de conta. Em producao a API fica
# sob /api/* na MESMA origem da vitrine (docs/producao.md §2).
NEXT_PUBLIC_API_URL=http://localhost:3333

# ── Medicao (GA4) ───────────────────────────────────────────────────────────
# ID de fluxo do Google Analytics 4 (formato G-XXXXXXXXXX). VAZIA = medicao
# DESLIGADA: o gtag.js nem entra na pagina. Mesmo definida, o script so carrega
# depois que o visitante ACEITA no banner de cookies — e o que a Politica de
# privacidade promete. Ver components/analytics/ScriptsAnalytics.tsx.
# ATENCAO (pendencia da Onda 2-D): o CSP em next.config.mjs ainda precisa
# liberar https://www.googletagmanager.com (script-src) e
# https://*.google-analytics.com (connect-src) para o GA4 funcionar em producao.
NEXT_PUBLIC_GA4_ID=

# ── WhatsApp da loja ────────────────────────────────────────────────────────
# Numero em formato internacional, so digitos (ex.: 5537999990000). VAZIA =
# nem o botao flutuante nem o link do rodape aparecem. Usada em
# components/layout/BotaoWhatsApp.tsx e no Rodape.
NEXT_PUBLIC_WHATSAPP=
